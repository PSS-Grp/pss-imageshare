# このファイルを .env という名前でコピーして、値を書き換えてください。
# .env は .gitignore に含まれているので GitHub にはプッシュされません。

# Neon のダッシュボード「Connect」でコピーできる接続文字列
DATABASE_URL=postgresql://ユーザー名:パスワード@xxxx.neon.tech/neondb?sslmode=require

# 画像の保存先(Supabase Storage)
# Supabase ダッシュボードの「Project Settings」→「API」でコピーできる値
SUPABASE_URL=https://xxxx.supabase.co
# service_role キー(サーバー専用・絶対にブラウザ側や GitHub に出さないこと)
SUPABASE_SERVICE_ROLE_KEY=
# 画像を入れるバケット名(省略可、既定は images。無ければ起動時に非公開で自動作成)
# SUPABASE_BUCKET=images

# サイトに入るための共通パスワード
SITE_PASSWORD=change-me

# ログイン Cookie の署名用のランダムな長い文字列(例: openssl rand -hex 32 で生成)
SESSION_SECRET=change-me-to-a-long-random-string

# ログインの有効時間(時間単位・省略可、既定は720=30日)
# SESSION_HOURS=720
